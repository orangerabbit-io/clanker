# Copy to `keystore.properties` (gitignored) and fill in to sign release builds.
# Without this file, :app:assembleRelease still configures but produces an UNSIGNED APK.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore /path/to/release.jks -alias <alias> \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=/absolute/path/to/release.jks
storePassword=
keyAlias=
keyPassword=
